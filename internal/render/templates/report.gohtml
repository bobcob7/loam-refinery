{{- /* internal/render/templates/report.gohtml — the page skeleton. Bead
.1 owns this file: only the doctype/head/body shell and {{template}}
calls into the partials each later bead owns live here. Nothing below
reads a caller-authored field directly — every value that does goes
through the partial responsible for it, escaped by html/template's own
contextual autoescaper (docs/features/html-report.md §4). */ -}}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>collect-reviews: {{.Envelope.Ref}}</title>
<style>
/* Skeleton only (§7's layout is bead .5's, §6.2's token palette is bead
   .4's — both append below via {{template "style"}} / {{template
   "codeStyle"}}, into templates/report.css and templates/code.css). */
:root { color-scheme: light dark; }
body { font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
pre, code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
{{template "style"}}
{{template "codeStyle"}}
</style>
</head>
<body>
{{template "envelope" .Envelope}}
{{template "index" .Envelope}}
{{template "toolbar" .}}
<section id="findings">
{{range .Findings}}{{template "finding" .}}
{{end}}</section>
{{template "script"}}
</body>
</html>
